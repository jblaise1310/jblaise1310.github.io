      <aliases enabled='yes' />
      <column aggregation='None' caption='Age (bin)' datatype='integer' hidden='true' name='[Age (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='1' formula='[age]' peg='0' size='10' />
      </column>
      <column caption='Count-Gender ' datatype='integer' hidden='true' name='[Calculation_157907476183298049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [gender]: COUNTD([patient_id]) }' />
      </column>
      <column caption='Readmis Rate Per State' datatype='real' hidden='true' name='[Calculation_157907477355372547]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5441896473522737154]/[Calculation_5441896473518813184]' />
      </column>
      <column caption='Income Categories' datatype='string' name='[Calculation_157907477400432644]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [income] &lt;= 50000 THEN &quot;0-50&quot;&#10;ELSEIF [income] &gt; 50000 AND [income] &lt;= 100000 THEN &quot;50-100&quot;&#10;ELSEIF [income] &gt; 100000 AND [income] &lt;= 150000 THEN &quot;100-150&quot;&#10;ELSEIF [income] &gt; 150000 AND [income] &lt;= 200000 THEN &quot;150-200&quot;&#10;ELSE &quot;200+&quot;&#10;END' />
      </column>
      <column caption='Readmis-NO' datatype='real' name='[Calculation_157907477777231883]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [readmis] = &apos;No&apos; THEN 1 ELSE 0 END) / COUNT([patient_id])' />
      </column>
      <column caption='Weighted-Readmission Score' datatype='real' hidden='true' name='[Calculation_157907478010204175]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5441896473522737154]/[Calculation_5441896473518813184]*1000' />
      </column>
      <column aggregation='Sum' caption='State-SDoH-Risk' datatype='real' name='[Calculation_157907478039166994]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [state]: SUM([sdoh_score]) } / { FIXED [state]: SUM([totalpopulation]) } *100000' />
      </column>
      <column aggregation='Sum' caption='Indv-Pts-Med-Risk' datatype='integer' name='[Calculation_157907478151815189]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[allergic_rhinitis_score]+&#10;[anxiety_score]+&#10;[arthritis_score]+&#10;[asthma_score]+&#10;[backpain_score]+&#10;[diabetes_score]+&#10;[highblood_score]+&#10;[hyperlipidemia_score]+&#10;[overweight_score]+&#10;[reflux_esophagitis_score]+&#10;[stroke_score]' />
      </column>
      <column caption='sdoh_high' datatype='integer' hidden='true' name='[Calculation_1618621864460083202]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [sdoh_score] &gt; 6.25 THEN 1 ELSE 0 END' />
      </column>
      <column caption='ReAdmis Rate' datatype='real' hidden='true' name='[Calculation_1618621864837431304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [readmis] = &apos;Yes&apos; THEN [patient_id] END ) / COUNTD([patient_id])' />
      </column>
      <column caption='Pt Risk' datatype='real' name='[Calculation_1719741757497372674]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[allergic_rhinitis_score]+&#10;[anxiety_score]+&#10;[arthritis_score]+&#10;[asthma_score]+&#10;[backpain_score]+&#10;[diabetes_score]+&#10;[highblood_score]+&#10;[hyperlipidemia_score]+&#10;[overweight_score]+&#10;[reflux_esophagitis_score]+&#10;[stroke_score]+&#10;[readmit_risk_score]+&#10;{ FIXED [state]: SUM([sdoh_score]) } / { FIXED [state]: SUM([totalpopulation]) } *100000' />
      </column>
      <column caption='Count - Distinct - Patients' datatype='integer' name='[Calculation_5441896473518813184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([patient_id])' />
      </column>
      <column caption='Indv-Patient-Readmitted' datatype='integer' name='[Calculation_5441896473522737154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;  IF { FIXED [patient_id] : MAX(IF [readmis] = &apos;Yes&apos; THEN 1 ELSE 0 END) } = 1&#10;  THEN 1 ELSE 0 &#10;END&#10;)' />
      </column>
      <column caption='ReAdmitted No' datatype='integer' hidden='true' name='[Calculation_5441896473522925571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [readmis] = &apos;No&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='zero' datatype='integer' hidden='true' name='[Calculation_5441896473601552388]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='ReAdmitted Status' datatype='string' name='[Calculation_5441896473616547845]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [readmis] = &apos;Yes&apos; THEN &apos;Readmitted&apos;&#10;ELSE &apos;Not Readmitted&apos;&#10;END' />
      </column>
      <column caption='Min' datatype='integer' hidden='true' name='[Calculation_5441896473627783174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Patient Global - Readmitted YES' datatype='real' hidden='true' name='[Calculation_5441896473650962439]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [readmis] = &apos;Yes&apos; THEN 1 ELSE 0 END) / COUNT([patient_id])' />
      </column>
      <column caption='Age Groups keep' datatype='string' name='[Calculation_5441896473667063820]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &lt; 21 THEN &quot;Under 21&quot;&#10;ELSEIF [age] &lt;= 32 THEN &quot;21-32&quot;&#10;ELSEIF [age] &lt;= 42 THEN &quot;33-42&quot;&#10;ELSEIF [age] &lt;= 52 THEN &quot;43-52&quot;&#10;ELSEIF [age] &lt;= 62 THEN &quot;53-62&quot;&#10;ELSEIF [age] &lt;= 72 THEN &quot;63-72&quot;&#10;ELSEIF [age] &lt;= 82 THEN &quot;73-82&quot;&#10;ELSE &quot;Over 82&quot;&#10;END' />
      </column>
      <column caption='Top Diagnoses' datatype='string' hidden='true' name='[Calculation_5441896473684287501]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [allergic_rhinitis_score] &gt;= [anxiety_score] AND [allergic_rhinitis_score] &gt;= [arthritis_score] AND [allergic_rhinitis_score] &gt;= [asthma_score] // continue for all conditions&#10;THEN &quot;Allergic Rhinitis&quot;&#10;ELSEIF [anxiety_score] &gt;= [allergic_rhinitis_score] AND [anxiety_score] &gt;= [arthritis_score] AND [anxiety_score] &gt;= [asthma_score] // continue for all conditions&#10;THEN &quot;Anxiety&quot;&#10;ELSEIF [arthritis_score] &gt;= [allergic_rhinitis_score] AND [arthritis_score] &gt;= [anxiety_score] AND [arthritis_score] &gt;= [asthma_score] // continue for all conditions&#10;THEN &quot;Arthritis&quot;&#10;// Add additional ELSEIF for each condition&#10;ELSE &quot;Other&quot;&#10;END' />
      </column>
      <column caption='Diagnosis Rate - Allergic Rhinitis ' datatype='real' hidden='true' name='[Calculation_5441896473751994382]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [allergic_rhinitis] = &apos;Yes&apos; AND [readmis] = &apos;Yes&apos; THEN 1&#10;     ELSEIF [allergic_rhinitis] = &apos;Yes&apos; THEN 0&#10;     END)' />
      </column>
      <column caption='Diagnoses' datatype='string' name='[Calculation_5441896473836744732]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [allergic_rhinitis] = &apos;Yes&apos; THEN &apos;Allergic Rhinitis&apos;&#10;ELSEIF [anxiety] = &apos;Yes&apos; THEN &apos;Anxiety&apos;&#10;ELSEIF [arthritis] = &apos;Yes&apos; THEN &apos;Arthritis&apos;&#10;ELSEIF [asthma] = &apos;Yes&apos; THEN &apos;Asthma&apos;&#10;ELSEIF [backpain] = &apos;Yes&apos; THEN &apos;Backpain&apos;&#10;ELSEIF [diabetes] = &apos;Yes&apos; THEN &apos;Diabetes&apos;&#10;ELSEIF [highblood] = &apos;Yes&apos; THEN &apos;HB Pressure&apos;&#10;ELSEIF [hyperlipidemia] = &apos;Yes&apos; THEN &apos;Hyperlipidemia&apos;&#10;ELSEIF [overweight] = &apos;Yes&apos; THEN &apos;Overweight&apos;&#10;ELSEIF [reflux_esophagitis] = &apos;Yes&apos; THEN &apos;Reflux Esophagitis&apos;&#10;ELSEIF [stroke] = &apos;Yes&apos; THEN &apos;Stroke&apos;&#10;END' />
      </column>
      <column caption='SDoH Avg' datatype='real' name='[Calculation_5441896473854615581]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([sdoh_score])' />
      </column>
      <column caption='Total ReAdmis Rate' datatype='real' hidden='true' name='[Calculation_5441896474562387998]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [readmis] = &apos;Yes&apos; THEN 1 ELSE 0 END) / COUNT([readmis])' />
      </column>
      <column caption='ReAmitted w Allergic Rhinitis' datatype='real' hidden='true' name='[Calculation_5441896474563371039]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [readmis] = &apos;Yes&apos; THEN IF [allergic_rhinitis] = &apos;Yes&apos; THEN 1 ELSE 0 END ELSE 0 END)' />
      </column>
      <column caption='Pts Per State' datatype='integer' hidden='true' name='[Calculation_5441896475216875563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [state]: COUNTD([patient_id]) }' />
      </column>
      <column caption='ReAdmitted by Age' datatype='real' hidden='true' name='[Calculation_5441896475228569645]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [state]: AVG(IF [readmis] = &apos;Yes&apos; THEN [age] ELSE NULL END) }' />
      </column>
      <column caption='Avg Income of ReAdmitted Pts' datatype='real' hidden='true' name='[Calculation_5441896475235958830]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [state]: AVG(IF [readmis] = &apos;Yes&apos; THEN [income] ELSE NULL END) }' />
      </column>
      <column caption='Gender - Readmit YES' datatype='real' hidden='true' name='[Calculation_5441896475238522927]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [gender]: SUM(IF [readmis] = &apos;Yes&apos; THEN 1 ELSE 0 END) / COUNTD([patient_id])}' />
      </column>
      <column caption='Flag - Avg Readmitted' datatype='real' hidden='true' name='[Calculation_5441896475407597619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [readmis] = &apos;Yes&apos; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='ReAdmitted Pts - Sum by Diagnosis' datatype='integer' hidden='true' name='[Calculation_5441896475418521652]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [readmis] = &apos;Yes&apos; THEN [patient_id] END)' />
      </column>
      <column caption='Diagnosis Specific ReAdmission' datatype='real' hidden='true' name='[Calculation_5441896475425083446]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_5441896473836744732]: SUM(IF [readmis] = &apos;Yes&apos; THEN 1.2 ELSE 0 END) }' />
      </column>
      <column caption='Count-Patients' datatype='integer' hidden='true' name='[Calculation_5441896475534118967]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([patient_id])' />
      </column>
      <column caption='Readmission-Risk' datatype='integer' name='[Calculation_5441896475579871289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [readmis] = &apos;Yes&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='State Readmission Rate' datatype='real' hidden='true' name='[Calculation_5441896475584696378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [state]: COUNTD(IF [readmis] = &apos;Yes&apos; THEN [patient_id] END) } / &#10;{ FIXED [state]: COUNTD([patient_id]) }' />
      </column>
      <column caption='Score-State ReAdmit ' datatype='integer' hidden='true' name='[Calculation_5441896475606589499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_5441896475584696378] &gt;= 0.50 THEN 5&#10;ELSEIF [Calculation_5441896475584696378] &gt;= 0.40 THEN 4&#10;ELSEIF [Calculation_5441896475584696378] &gt;= 0.30 THEN 3&#10;ELSEIF [Calculation_5441896475584696378] &gt;= 0.29 THEN 2&#10;ELSE 1&#10;END' />
      </column>
      <column caption='KPI-Medical Score' datatype='real' name='[Calculation_5441896475932602429]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;  [allergic_rhinitis_score] + &#10;  [anxiety_score] + &#10;  [arthritis_score] + &#10;  [asthma_score] + &#10;  [backpain_score] + &#10;  [diabetes_score] + &#10;  [highblood_score] + &#10;  [hyperlipidemia_score] + &#10;  [overweight_score] + &#10;  [reflux_esophagitis_score] + &#10;  [stroke_score]&#10;)' />
      </column>
      <column caption='KPI-Avg Readmit Risk' datatype='real' name='[Calculation_5441896475933118526]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_5441896475579871289])' />
      </column>
      <column caption='Percentile Readmis Risk' datatype='real' hidden='true' name='[Calculation_5441896476094693441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_PERCENTILE([Calculation_5441896476003692607], &apos;asc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Percentile Readmission Risk 10' datatype='boolean' hidden='true' name='[Calculation_5441896476096581698]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_5441896476003692607] &lt;= INT(TOTAL(COUNTD([patient_id])) * 0.1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sex' datatype='string' hidden='true' name='[Calculation_5441896476111777860]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [gender] = &apos;Male&apos; THEN &apos;M&apos;&#10;ELSEIF [gender] = &apos;Female&apos; THEN &apos;F&apos;&#10;ELSEIF [gender] = &apos;Prefer not to answer&apos; THEN &apos;PNA&apos;&#10;END' />
      </column>
      <column caption='Weighted-Readmissions' datatype='real' name='[Calculation_5869316231500861445]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Readmis NO (copy)_157907477777444876]/[Calculation_5441896473518813184]*1000' />
      </column>
      <column caption='Diagnosis - List' datatype='string' name='[Calculation_6851804665574248448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE(&#10;  IF [arthritis] = &apos;Yes&apos; THEN &apos;Arthritis, &apos; ELSE &apos;&apos; END +&#10;  IF [anxiety] = &apos;Yes&apos; THEN &apos;Anxiety, &apos; ELSE &apos;&apos; END +&#10;  IF [allergic_rhinitis] = &apos;Yes&apos; THEN &apos;Allergic Rhinitis, &apos; ELSE &apos;&apos; END +&#10;  IF [asthma] = &apos;Yes&apos; THEN &apos;Asthma, &apos; ELSE &apos;&apos; END +&#10;  IF [backpain] = &apos;Yes&apos; THEN &apos;Backpain, &apos; ELSE &apos;&apos; END +&#10;  IF [diabetes] = &apos;Yes&apos; THEN &apos;Diabetes, &apos; ELSE &apos;&apos; END +&#10;  IF [highblood] = &apos;Yes&apos; THEN &apos;Highblood Pressure, &apos; ELSE &apos;&apos; END +&#10;  IF [hyperlipidemia] = &apos;Yes&apos; THEN &apos;Hyperlipidemia, &apos; ELSE &apos;&apos; END +&#10;  IF [overweight] = &apos;Yes&apos; THEN &apos;Overweight, &apos; ELSE &apos;&apos; END +&#10;  IF [reflux_esophagitis] = &apos;Yes&apos; THEN &apos;Reflux Esophagitis, &apos; ELSE &apos;&apos; END +&#10;  IF [stroke] = &apos;Yes&apos; THEN &apos;Stroke, &apos; ELSE &apos;&apos; END, &#10;&apos;, $&apos;, &apos;&apos;)' />
      </column>
      <column caption='Diagnosis Rate - Anxiety' datatype='real' hidden='true' name='[Diagnosis Rate - Allergic Rhinitis  (copy)_5441896473752858639]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [anxiety] = &apos;Yes&apos; AND [readmis] = &apos;Yes&apos; THEN 1&#10;     ELSEIF [anxiety] = &apos;Yes&apos; THEN 0&#10;     END)' />
      </column>
      <column caption='Diagnosis Rate - Arthritis' datatype='real' hidden='true' name='[Diagnosis Rate - Anxiety (copy)_5441896473826291730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [arthritis] = &apos;Yes&apos; AND [readmis] = &apos;Yes&apos; THEN 1&#10;     ELSEIF [arthritis] = &apos;Yes&apos; THEN 0&#10;     END)' />
      </column>
      <column caption='Diagnosis Rate - Backpain' datatype='real' hidden='true' name='[Diagnosis Rate - Arthritis (copy)_5441896473826422803]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [backpain] = &apos;Yes&apos; AND [readmis] = &apos;Yes&apos; THEN 1&#10;     ELSEIF [backpain] = &apos;Yes&apos; THEN 0&#10;     END)' />
      </column>
      <column caption='Diagnosis Rate - Asthma' datatype='real' hidden='true' name='[Diagnosis Rate - Arthritis (copy)_5441896473831862299]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [asthma] = &apos;Yes&apos; AND [readmis] = &apos;Yes&apos; THEN 1&#10;     ELSEIF [asthma] = &apos;Yes&apos; THEN 0&#10;     END)' />
      </column>
      <column caption='Diagnosis Rate - Diabetes' datatype='real' hidden='true' name='[Diagnosis Rate - Backpain (copy)_5441896473826557972]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [diabetes] = &apos;Yes&apos; AND [readmis] = &apos;Yes&apos; THEN 1&#10;     ELSEIF [diabetes] = &apos;Yes&apos; THEN 0&#10;     END)' />
      </column>
      <column caption='Diagnosis Rate - Highblood' datatype='real' hidden='true' name='[Diagnosis Rate - Diabetes (copy)_5441896473826684949]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [highblood] = &apos;Yes&apos; AND [readmis] = &apos;Yes&apos; THEN 1&#10;     ELSEIF [highblood] = &apos;Yes&apos; THEN 0&#10;     END)' />
      </column>
      <column caption='Diagnosis Rate - Hyperlipidemia' datatype='real' hidden='true' name='[Diagnosis Rate - Highblood (copy)_5441896473826816022]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [hyperlipidemia] = &apos;Yes&apos; AND [readmis] = &apos;Yes&apos; THEN 1&#10;     ELSEIF [hyperlipidemia] = &apos;Yes&apos; THEN 0&#10;     END)' />
      </column>
      <column caption='Diagnosis Rate - Overweight' datatype='real' hidden='true' name='[Diagnosis Rate - Hyperlipidemia (copy)_5441896473826947095]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [overweight] = &apos;Yes&apos; AND [readmis] = &apos;Yes&apos; THEN 1&#10;     ELSEIF [overweight] = &apos;Yes&apos; THEN 0&#10;     END)' />
      </column>
      <column caption='Diagnosis Rate - Reflux Esophagitis' datatype='real' hidden='true' name='[Diagnosis Rate - Overweight (copy)_5441896473827127321]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [reflux_esophagitis] = &apos;Yes&apos; AND [readmis] = &apos;Yes&apos; THEN 1&#10;     ELSEIF [reflux_esophagitis] = &apos;Yes&apos; THEN 0&#10;     END)' />
      </column>
      <column caption='Diagnosis Rate - Stroke' datatype='real' hidden='true' name='[Diagnosis Rate -Reflux Esophagitis (copy)_5441896473827348506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [stroke] = &apos;Yes&apos; AND [readmis] = &apos;Yes&apos; THEN 1&#10;     ELSEIF [stroke] = &apos;Yes&apos; THEN 0&#10;     END)' />
      </column>
      <column caption='Gender - Readmit NO' datatype='real' hidden='true' name='[Gender - Readmit YES (copy)_157907477772800010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [gender]: SUM(IF [readmis] = &apos;No&apos; THEN 1 ELSE 0 END) / COUNTD([patient_id])}' />
      </column>
      <column caption='Readmis Rate PNA' datatype='real' hidden='true' name='[Gender-Male-ReAdmitted (copy)_5441896475258306610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [state]: AVG(IF [gender] = &apos;Prefer not to answer&apos; AND [readmis] = &apos;Yes&apos; THEN 1 ELSE 0 END) }' />
      </column>
      <column caption='Med-Score-Total' datatype='integer' name='[Med-Score-Total (copy)_5869316230966734848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[allergic_rhinitis_score]+&#10;[anxiety_score]+&#10;[arthritis_score]+&#10;[asthma_score]+&#10;[backpain_score]+&#10;[diabetes_score]+&#10;[highblood_score]+&#10;[highblood_score]+&#10;[overweight_score]+&#10;[reflux_esophagitis_score]+&#10;[stroke_score]' />
      </column>
      <column caption='Percentile Readmission Risk 25' datatype='boolean' hidden='true' name='[Percentile Readmission Risk 10 (copy)_5441896476096786499]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_5441896476003692607] &lt;= INT(TOTAL(COUNTD([patient_id])) * 0.25)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Patient Global - Readmitted NO' datatype='real' hidden='true' name='[ReAdmis Rate Per Pt YES (copy)_157907477217054722]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [readmis] = &apos;No&apos; THEN 1 ELSE 0 END) / COUNT([patient_id])' />
      </column>
      <column caption='Readmis-YES' datatype='real' name='[Readmis NO (copy)_157907477777444876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [readmis] = &apos;Yes&apos; THEN 1 ELSE 0 END) / COUNT([patient_id])' />
      </column>
      <column caption='Pts-Readmit-Risk' datatype='real' hidden='true' name='[Readmission-Risk (copy)_5869316231464460292]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [readmis] = &apos;Yes&apos; THEN 1.2 ELSE 0 END' />
      </column>
      <column datatype='string' name='[SDOH Factors]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;Crowding among housing units&quot;' value='Crowding' />
          <alias key='&quot;Housing cost burden among households&quot;' value='Housing Cost' />
          <alias key='&quot;No broadband internet subscription among households&quot;' value='No Broadband' />
          <alias key='&quot;No high school diploma among adults aged 25 years or older&quot;' value='No HS Diploma' />
          <alias key='&quot;Persons aged 65 years or older&quot;' value='Aged 65+' />
          <alias key='&quot;Persons living below 150\% of the poverty level&quot;' value='150%&lt; Poverty' />
          <alias key='&quot;Persons of racial or ethnic minority status&quot;' value='Minority' />
          <alias key='&quot;Single-parent households&quot;' value='Single-parent Home' />
          <alias key='&quot;Unemployment among people 16 years and older in the labor force&quot;' value='16+ Unemployed' />
        </aliases>
      </column>
      <column caption='Regions' datatype='string' name='[State (group)]' role='dimension' semantic-role='[State].[Name]' type='nominal'>
        <calculation class='categorical-bin' column='[state]' new-bin='true'>
          <bin default-name='false' value='&quot;East North Central&quot;'>
            <value>&quot;IL&quot;</value>
            <value>&quot;IN&quot;</value>
            <value>&quot;MI&quot;</value>
            <value>&quot;OH&quot;</value>
            <value>&quot;WI&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;East South Central&quot;'>
            <value>&quot;AL&quot;</value>
            <value>&quot;KY&quot;</value>
            <value>&quot;MS&quot;</value>
            <value>&quot;TN&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Mid Atlantic&quot;'>
            <value>&quot;NJ&quot;</value>
            <value>&quot;NY&quot;</value>
            <value>&quot;PA&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Mountain&quot;'>
            <value>&quot;AZ&quot;</value>
            <value>&quot;CO&quot;</value>
            <value>&quot;ID&quot;</value>
            <value>&quot;MT&quot;</value>
            <value>&quot;NM&quot;</value>
            <value>&quot;NV&quot;</value>
            <value>&quot;UT&quot;</value>
            <value>&quot;WY&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;New England&quot;'>
            <value>&quot;CT&quot;</value>
            <value>&quot;MA&quot;</value>
            <value>&quot;ME&quot;</value>
            <value>&quot;NH&quot;</value>
            <value>&quot;RI&quot;</value>
            <value>&quot;VT&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Offshore&quot;'>
            <value>&quot;AK&quot;</value>
            <value>&quot;PR&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Pacific&quot;'>
