        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='postgres.116y43t0hth17515ycl3w07un7lp' name='Custom SQL Query' type='text'>SELECT &quot;new_sdoh_data&quot;.&quot;SDOH Factors&quot; AS &quot;SDOH Factors&quot;,
  &quot;new_med_data&quot;.&quot;age&quot; AS &quot;age&quot;,
  CAST(&quot;new_med_data&quot;.&quot;allergic_rhinitis&quot; AS TEXT) AS &quot;allergic_rhinitis&quot;,
  CAST(&quot;new_med_data&quot;.&quot;anxiety&quot; AS TEXT) AS &quot;anxiety&quot;,
  CAST(&quot;new_med_data&quot;.&quot;arthritis&quot; AS TEXT) AS &quot;arthritis&quot;,
  CAST(&quot;new_med_data&quot;.&quot;asthma&quot; AS TEXT) AS &quot;asthma&quot;,
  &quot;new_med_data&quot;.&quot;allergic_rhinitis_score&quot; AS &quot;allergic_rhinitis_score&quot;,
  &quot;new_med_data&quot;.&quot;anxiety_score&quot; AS &quot;anxiety_score&quot;,  
  &quot;new_med_data&quot;.&quot;arthritis_score&quot; AS &quot;arthritis_score&quot;,
  &quot;new_med_data&quot;.&quot;asthma_score&quot; AS &quot;asthma_score&quot;,
  CAST(&quot;new_med_data&quot;.&quot;backpain&quot; AS TEXT) AS &quot;backpain&quot;,
  &quot;new_med_data&quot;.&quot;backpain_score&quot; AS &quot;backpain_score&quot;,
  &quot;new_med_data&quot;.&quot;children&quot; AS &quot;children&quot;,
  CAST(&quot;new_sdoh_data&quot;.&quot;county&quot; AS TEXT) AS &quot;county (new_sdoh_data)&quot;,
  CAST(&quot;new_med_data&quot;.&quot;county&quot; AS TEXT) AS &quot;county&quot;,
  &quot;new_sdoh_data&quot;.&quot;data_value&quot; AS &quot;data_value&quot;,
  CAST(&quot;new_med_data&quot;.&quot;diabetes&quot; AS TEXT) AS &quot;diabetes&quot;,
  &quot;new_med_data&quot;.&quot;diabetes_score&quot; AS &quot;diabetes_score&quot;,
  CAST(&quot;new_med_data&quot;.&quot;gender&quot; AS TEXT) AS &quot;gender&quot;,
  CAST(&quot;new_med_data&quot;.&quot;highblood&quot; AS TEXT) AS &quot;highblood&quot;,
  &quot;new_med_data&quot;.&quot;highblood_score&quot; AS &quot;highblood_score&quot;,
  CAST(&quot;new_med_data&quot;.&quot;hyperlipidemia&quot; AS TEXT) AS &quot;hyperlipidemia&quot;,
  &quot;new_med_data&quot;.&quot;hyperlipidemia_score&quot; AS &quot;hyperlipidemia_score&quot;,
  &quot;new_med_data&quot;.&quot;income&quot; AS &quot;income&quot;,
  CAST(&quot;new_med_data&quot;.&quot;marital&quot; AS TEXT) AS &quot;marital&quot;,
  &quot;new_sdoh_data&quot;.&quot;measure&quot; AS &quot;measure&quot;,
  CAST(&quot;new_med_data&quot;.&quot;overweight&quot; AS TEXT) AS &quot;overweight&quot;,
  &quot;new_med_data&quot;.&quot;overweight_score&quot; AS &quot;overweight_score&quot;,
  CAST(&quot;new_med_data&quot;.&quot;patient_id&quot; AS TEXT) AS &quot;patient_id&quot;,
  &quot;new_med_data&quot;.&quot;population&quot; AS &quot;population&quot;,
  CAST(&quot;new_med_data&quot;.&quot;readmis&quot; AS TEXT) AS &quot;readmis&quot;,
  CAST(&quot;new_med_data&quot;.&quot;reflux_esophagitis&quot; AS TEXT) AS &quot;reflux_esophagitis&quot;,
  &quot;new_med_data&quot;.&quot;reflux_esophagitis_score&quot; AS &quot;reflux_esophagitis_score&quot;,
  &quot;new_sdoh_data&quot;.&quot;sdoh_score&quot; AS &quot;sdoh_score&quot;,
  &quot;new_med_data&quot;.&quot;service_count&quot; AS &quot;service_count&quot;,
  &quot;new_sdoh_data&quot;.&quot;state&quot; AS &quot;state (new_sdoh_data)&quot;,
  CAST(&quot;new_med_data&quot;.&quot;state&quot; AS TEXT) AS &quot;state&quot;,
  CAST(&quot;new_med_data&quot;.&quot;stroke&quot; AS TEXT) AS &quot;stroke&quot;,
