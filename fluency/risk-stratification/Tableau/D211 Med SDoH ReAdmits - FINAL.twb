  &quot;new_med_data&quot;.&quot;readmit_risk_score&quot; AS &quot;readmit_risk_score&quot;,
  &quot;new_sdoh_data&quot;.&quot;totalpopulation&quot; AS &quot;totalpopulation&quot;
FROM &quot;public&quot;.&quot;new_med_data&quot; &quot;new_med_data&quot;
